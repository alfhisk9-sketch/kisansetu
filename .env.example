# ==============================================================================
# KisanSetu Platform — Environment Configuration Template
# Real secrets must exist ONLY in local .env or Render/Vercel dashboard.
# NEVER place real secrets or keys in this file.
# ==============================================================================

# Client Frontend Environment Variables (Vite prefixed — safe for browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_URL=/api

# Server Only Secrets (NEVER expose to browser client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Optional Google OAuth Server Credentials (if not managed directly via Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

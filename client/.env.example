# ==============================================================================
# KisanSetu Client Frontend Environment Variables (Vite)
# ==============================================================================

# API Base URL (defaults to relative /api when served same-origin by Express in production)
VITE_API_URL=/api

# Optional Client Supabase Connection (Only anon key — NEVER put service role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Maps JavaScript API Key (If omitted, uses OpenStreetMap/Leaflet fallback)
VITE_GOOGLE_MAPS_API_KEY=


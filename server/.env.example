# ==============================================================================
# KisanSetu Server Environment Variables
# Real secrets belong ONLY in local .env or Render environment dashboard.
# NEVER place real secrets or keys in this file.
# ==============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Google Gemini API Key (Server-side only — never sent to browser client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase Production PostgreSQL Settings (Server-side service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Optional Google OAuth Server Credentials (if not managed directly via Supabase Auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
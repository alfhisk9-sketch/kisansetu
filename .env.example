# ==============================================================================
# KisanSetu Platform — Environment Configuration Template
# Never commit the real .env file with production secrets.
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI Integration (Server-side ONLY — Never exposed to frontend)
# Used for KisanSetu AI Saathi conversational intelligence grounded in mandi arrivals.
# If unset, AI Saathi automatically falls back to deterministic rule-based answers.
GEMINI_API_KEY=

# Supabase PostgreSQL Configuration (Optional — fallback to local SQLite when unset)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Client Frontend Environment Variables (Vite prefixed)
VITE_API_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

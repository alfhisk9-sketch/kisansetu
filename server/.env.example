# ==============================================================================
# KisanSetu Server Environment Variables
# ==============================================================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=*

# Google Gemini API Key (Server-side only — never sent to browser client)
# Obtains grounded answers in Hindi, Marathi, Telugu, and English.
GEMINI_API_KEY=

# Supabase Production PostgreSQL Settings (Optional)
# If left empty, the server automatically operates on local SQLite (server/data/krishisetu.db)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
